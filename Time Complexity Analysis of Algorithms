//Find the largest element in an array
#include <iostream>
using namespace std;
int main(){
    int n, a[100], max;
    cout << "Enter array size: ";
    cin >> n;
    cout << "Enter elements: ";
    for(int i = 0; i < n; i++)
        cin >> a[i];
    max = a[0];
    for(int i = 1; i < n; i++){
        if(a[i] > max)
            max = a[i];
    }
    cout << "Largest element = " << max;
    return 0;
}
Time Complexity: O(n)

//Find the minimum element and count iterations
#include <iostream>
using namespace std;
int main(){
    int n, a[100], min, count = 0;
    cout << "Enter array size: ";
    cin >> n;
    cout << "Enter elements: ";
    for(int i = 0; i < n; i++)
        cin >> a[i];
    min = a[0];
    for(int i = 1; i < n; i++){
        count++;
        if(a[i] < min)
            min = a[i];
    }
    cout << "Minimum element = " << min;
    cout << "\nNumber of iterations = " << count;
    return 0;
}
Time Complexity: O(n)

//Calculate the sum of array elements
#include <iostream>
using namespace std;
int main(){
    int n, a[100], sum = 0;
    cout << "Enter array size: ";
    cin >> n;
    cout << "Enter elements: ";
    for(int i = 0; i < n; i++)
        cin >> a[i];
    for(int i = 0; i < n; i++)
        sum = sum + a[i];
    cout << "Sum = " << sum;
    return 0;
}
Time Complexity: O(n)

//Find duplicate elements in an array
#include <iostream>
using namespace std;
int main(){
    int n, a[100];
    cout << "Enter array size: ";
    cin >> n;
    cout << "Enter elements: ";
    for(int i = 0; i < n; i++)
        cin >> a[i];
    cout << "Duplicate elements: ";
    for(int i = 0; i < n; i++){
        int count = 0;
        for(int j = 0; j < i; j++){
            if(a[i] == a[j])
                count++;
        }
        if(count == 0){
            for(int j = i + 1; j < n; j++){
                if(a[i] == a[j]){
                    cout << a[i] << " ";
                    break;
                }
            }
        }
    }
    return 0;
}
Time Complexity: O(n²)

//Reverse an array
#include <iostream>
using namespace std;
int main(){
    int n, a[100], temp;
    cout << "Enter array size: ";
    cin >> n;
    cout << "Enter elements: ";
    for(int i = 0; i < n; i++)
        cin >> a[i];
    int start = 0, end = n - 1;
    while(start < end){
        temp = a[start];
        a[start] = a[end];
        a[end] = temp;

        start++;
        end--;
    }
    cout << "Reversed array: ";
    for(int i = 0; i < n; i++)
        cout << a[i] << " ";
    return 0;
}
Time Complexity: O(n)

