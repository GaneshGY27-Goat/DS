//Implement a queue using an array
#include <iostream>
using namespace std;
int main(){
    int queue[100], front = -1, rear = -1;
    int n;
    cout << "Enter number of elements: ";
    cin >> n;
    for(int i = 0; i < n; i++){
        cin >> queue[i];
        rear++;
    }
    if(n > 0)
        front = 0;
    cout << "Queue elements: ";
    for(int i = front; i <= rear; i++)
        cout << queue[i] << " ";
    return 0;
}
Time Complexity: O(n) for displaying all elements.

//Perform ENQUEUE operation in a queue
#include <iostream>
using namespace std;
int main(){
    int queue[5], front = -1, rear = -1;
    int value;
    cout << "Enter value: ";
    cin >> value;
    if(rear == 4)
        cout << "Queue Overflow";
    else{
        if(front == -1)
            front = 0;
        queue[++rear] = value;
        cout << "Element inserted successfully";
    }
    return 0;
}
Time Complexity: O(1)

//Perform DEQUEUE operation in a queue
#include <iostream>
using namespace std;
int main(){
    int queue[5], front = 0, rear = 2;
    queue[0] = 10;
    queue[1] = 20;
    queue[2] = 30;
    if(front == -1 || front > rear)
        cout << "Queue Underflow";
    else{
        cout << "Deleted element = " << queue[front];
        front++;
    }
    return 0;
}
Time Complexity: O(1)

