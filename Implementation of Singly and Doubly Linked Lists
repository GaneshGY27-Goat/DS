//Delete a node from a doubly linked list
#include <iostream>
using namespace std;
struct Node{
    int data;
    Node *prev;
    Node *next;
};
int main(){
    Node *head = NULL, *temp, *newNode;
    int n, key;
    cout << "Enter number of nodes: ";
    cin >> n;
    for(int i = 0; i < n; i++){
        newNode = new Node;
        cin >> newNode->data;
        newNode->next = NULL;
        newNode->prev = NULL;
        if(head == NULL)
            head = newNode;
        else{
            temp = head;

            while(temp->next != NULL)
                temp = temp->next;

            temp->next = newNode;
            newNode->prev = temp;
        }
    }
    cout << "Enter value to delete: ";
    cin >> key;
    temp = head;
    while(temp != NULL && temp->data != key)
        temp = temp->next;
    if(temp == NULL){
        cout << "Element not found";
        return 0;
    }
    if(temp->prev != NULL)
        temp->prev->next = temp->next;
    else
        head = temp->next;
    if(temp->next != NULL)
        temp->next->prev = temp->prev;
    delete temp;
    cout << "Updated List: ";
    temp = head;
    while(temp != NULL){
        cout << temp->data << " <-> ";
        temp = temp->next;
    }
    cout << "NULL";
    return 0;
}
Time Complexity: O(n)

