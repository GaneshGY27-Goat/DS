//Delete the first node from a singly linked list
#include <iostream>
using namespace std;
struct Node{
    int data;
    Node *next;
};
int main(){
    Node *head = NULL, *temp, *newNode;
    int n;
    cout << "Enter number of nodes: ";
    cin >> n;
    for(int i = 0; i < n; i++){
        newNode = new Node;
        cin >> newNode->data;
        newNode->next = NULL;
        if(head == NULL)
            head = newNode;
        else{
            temp = head;
            while(temp->next != NULL)
                temp = temp->next;
            temp->next = newNode;
        }
    }
    if(head == NULL){
        cout << "List is empty";
        return 0;
    }
    temp = head;
    head = head->next;
    delete temp;
    cout << "After deletion: ";
    temp = head;
    while(temp != NULL){
        cout << temp->data << " -> ";
        temp = temp->next;
    }
    cout << "NULL";
    return 0;
}
Time Complexity: O(1)

//Delete the last node from a singly linked list
#include <iostream>
using namespace std;
struct Node{
    int data;
    Node *next;
};
int main(){
    Node *head = NULL, *temp, *newNode;
    int n;
    cout << "Enter number of nodes: ";
    cin >> n;
    for(int i = 0; i < n; i++){
        newNode = new Node;
        cin >> newNode->data;
        newNode->next = NULL;
        if(head == NULL)
            head = newNode;
        else{
            temp = head;
            while(temp->next != NULL)
                temp = temp->next;
            temp->next = newNode;
        }
    }
    if(head == NULL){
        cout << "List is empty";
        return 0;
    }
    if(head->next == NULL){
        delete head;
        head = NULL;
    }
    else{
        temp = head;
        while(temp->next->next != NULL)
            temp = temp->next;
        delete temp->next;
        temp->next = NULL;
    }
    cout << "After deletion: ";
    temp = head;
    while(temp != NULL){
        cout << temp->data << " -> ";
        temp = temp->next;
    }
    cout << "NULL";
    return 0;
}
Time Complexity: O(n)

//Search for a specified node in a linked list
#include <iostream>
using namespace std;
struct Node{
    int data;
    Node *next;
};
int main(){
    Node *head = NULL, *temp, *newNode;
    int n, key, pos = 1, found = 0;
    cout << "Enter number of nodes: ";
    cin >> n;
    for(int i = 0; i < n; i++){
        newNode = new Node;
        cin >> newNode->data;
        newNode->next = NULL;
        if(head == NULL)
            head = newNode;
        else{
            temp = head;
            while(temp->next != NULL)
                temp = temp->next;
            temp->next = newNode;
        }
    }
    cout << "Enter element to search: ";
    cin >> key;
    temp = head;
    while(temp != NULL){
        if(temp->data == key){
            cout << "Element found at position " << pos;
            found = 1;
            break;
        }
        temp = temp->next;
        pos++;
    }
    if(found == 0)
        cout << "Element not found";
    return 0;
}
Time Complexity: O(n)

