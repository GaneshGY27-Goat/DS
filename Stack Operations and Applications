//Implement PUSH operation using an array-based stack
#include <iostream>
using namespace std;
int main(){
    int stack[100], top = -1;
    int n, value;
    cout << "Enter number of elements: ";
    cin >> n;
    cout << "Enter elements: ";
    for(int i = 0; i < n; i++){
        cin >> value;
        if(top == 99)
            cout << "Stack Overflow\n";
        else
            stack[++top] = value;
    }
    cout << "Stack elements: ";
    for(int i = top; i >= 0; i--)
        cout << stack[i] << " ";
    return 0;
}
Time Complexity: O(1)

//Implement POP operation using an array-based stack
#include <iostream>
using namespace std;
int main(){
    int stack[100], top = -1;
    int n, value;
    cout << "Enter number of elements: ";
    cin >> n;
    cout << "Enter elements: ";
    for(int i = 0; i < n; i++)
        stack[++top] = 0, cin >> stack[top];
    if(top == -1)
        cout << "Stack Underflow";
    else{
        cout << "Deleted element = " << stack[top];
        top--;
    }
    cout << "\nStack after POP: ";
    for(int i = top; i >= 0; i--)
        cout << stack[i] << " ";
    return 0;
}
Time Complexity: O(1)

