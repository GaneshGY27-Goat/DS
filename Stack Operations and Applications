//Convert a decimal number into binary using a stack
#include <iostream>
using namespace std;
int main(){
    int stack[100], top = -1;
    int n;
    cout << "Enter decimal number: ";
    cin >> n;
    if(n < 0){
        cout << "Enter a non-negative number";
        return 0;
    }
    if(n == 0)
        stack[++top] = 0;
    while(n > 0){
        stack[++top] = n % 2;
        n = n / 2;
    }
    cout << "Binary number = ";
    while(top != -1)
        cout << stack[top--];
    return 0;
}
Time Complexity: O(log n)
